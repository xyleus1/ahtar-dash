{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/dash", "destination": "/", "permanent": true },
    { "source": "/dash/:path*", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/enjoying", "destination": "/" },
    { "source": "/reading", "destination": "/" },
    { "source": "/writing", "destination": "/" },
    { "source": "/writing/why-do-we-need-so-much-memory-anyway", "destination": "/" },
    { "source": "/building", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
